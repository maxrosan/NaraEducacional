# Configuração do transcription_service
# Copie para .env e ajuste para o seu ambiente.

# Modelo Whisper: tiny | base | small | medium | large-v3 | distil-large-v3
# Para turbo, use um repo HF com conversão CT2 (faster-whisper não tem short-name
# para turbo). Ex.: deepdml/faster-whisper-large-v3-turbo-ct2
MODEL_SIZE=large-v3

# Dispositivo: cpu | cuda
DEVICE=cpu

# Tipo de computação (depende do device):
#   CPU: int8 (default, rápido e preciso)
#   GPU: float16 ou int8_float16
COMPUTE_TYPE=int8

# Threads CPU (0 = auto)
CPU_THREADS=0

# Quantos segmentos processar em paralelo
NUM_WORKERS=1

# Diretório onde os pesos do modelo ficam cacheados (monte volume aqui em prod)
MODEL_CACHE=/models

# Workers que consomem a fila em paralelo (efetivamente o teto de transcrições
# simultâneas). Em CPU, cada worker carrega beam search pesado: não aumente
# sem monitorar RAM e latência.
MAX_CONCURRENT=2

# Capacidade da fila interna. Quando cheia, POST /transcribe responde 429 +
# Retry-After para o cliente tentar de novo.
QUEUE_MAX_SIZE=50

# Por quantos segundos um job terminal fica acessível via GET /jobs/{id} antes
# de ser purgado pelo janitor.
JOB_TTL_SECONDS=3600

# Intervalo (segundos) em que o janitor varre jobs expirados.
JANITOR_INTERVAL_SECONDS=60

# Idioma padrão quando o cliente não informa (ISO-639-1). Vazio = autodetect.
DEFAULT_LANGUAGE=pt

# VAD (Voice Activity Detection) - remove silêncios, melhora precisão
VAD_FILTER=true

# Beam size (1 = greedy, 5 = padrão, maior = melhor qualidade/mais lento)
BEAM_SIZE=5

# Token compartilhado obrigatório (vazio em dev, forte em produção)
INTERNAL_TOKEN=

# Tamanho máximo de upload em MB
MAX_UPLOAD_MB=100

# Porta HTTP
PORT=8000

# Log level
LOG_LEVEL=INFO

# Sentry (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Root environment file for both server (Django) and client (Vite)
# Duplicate this file to `.env` and adjust the values locally.

# ==== SERVER (Django) ====
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database (substitui SQLite)
# POSTGRES_HOST=postgres -> nome do serviço no docker-compose (rede interna).
# POSTGRES_PORT=5433 -> porta publicada no host pelo compose (ver docker-compose.yml).
#   Só é relevante se algo rodar FORA dos containers e precisar acessar o banco.
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=multi_nara_production
POSTGRES_USER=multi_nara_user
POSTGRES_PASSWORD=secure_password

# OpenAI API
OPENAI_API_KEY=sk-proj-your-key-here

# Supabase (integrações legadas e relatórios)
SUPABASE_URL=
SUPABASE_KEY=

# Limites e timeouts de IA/upload
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=50
IA_REQUEST_TIMEOUT_SECONDS=45
IA_AUDIO_TIMEOUT_SECONDS=45
UPLOAD_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# AWS S3 Storage (substitui Supabase Storage)
AWS_ACCESS_KEY_ID=AKIAXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_S3_BUCKET_NAME=multi-nara-production
AWS_REGION=us-east-1
AWS_PRESIGNED_TTL_SECONDS=3600

# ==== CLIENT (Vite) ====
# Prefix all variables consumed by Vite/React with VITE_
# Aponta para a porta publicada do backend no host (ver docker-compose.yml: "8011:8001")
VITE_API_BASE_URL=http://127.0.0.1:8011

# ==== EXPERIMENTAL: Reconhecimento de Fala Infantil ====
# Módulo experimental para análise de fala de crianças
# Cliente avisado: ainda não há IAs com precisão ideal para fala infantil
# Testar alternativas: ElevenLabs, Gemini, OpenAI Whisper

# ElevenLabs (opcional)
ELEVENLABS_API_KEY=

# Google Gemini (opcional)
GEMINI_API_KEY=

# Whisper (OpenAI) - já incluído no OPENAI_API_KEY

# ==== Scheduler (Celery worker externo) ====
# Token compartilhado com o scheduler para autenticar chamadas a
# POST /api/internal/cache/coordenacao/. Deixe vazio para desabilitar.
NARA_INTERNAL_TOKEN=

# UUID da instituição servida por este backend. Cada deploy é dedicado
# a uma escola — esse valor é a fonte de verdade para o backend.
# (No multi-tenant isso tende a deixar de ser 1:1 por backend — revisar
# quando a migration multi-tenant estiver definida.)
NARA_INSTITUICAO_ID=

# Botão "Atualizar" do painel da coordenação: enfileira o refresh do cache
# no broker do scheduler (mesmo Redis do beat/worker), usando o
# NARA_INSTITUICAO_ID acima como chave. Deixe vazio para desabilitar o botão
# (responde 503). Requer que o registry do scheduler tenha o instituicao_id
# preenchido para esta escola (ESCOLAS_JSON/escolas.yaml).
CELERY_BROKER_URL=redis://localhost:6379/0

# ==== Transcrição de áudio ====
# Seleciona o backend usado por `transcrever_audio`:
#   openai               -> Whisper-1 via OpenAI API (padrão)
#   faster_whisper       -> microserviço local transcription_service (Whisper Large v3)
#   openai_with_fallback -> tenta OpenAI; em rate-limit/quota/auth/5xx/conexão
#                           cai automaticamente para o microserviço local
TRANSCRIPTION_PROVIDER=openai

# Usados quando TRANSCRIPTION_PROVIDER=faster_whisper ou openai_with_fallback
TRANSCRIPTION_SERVICE_URL=http://transcription:8000
TRANSCRIPTION_SERVICE_TOKEN=

# ==== Análise de Leitura (NaraNN) ====
# Microserviço externo (repo NaraNN) que classifica o estágio de leitura
# da criança a partir de um áudio .ogg. Roda em container separado.
NARAONN_BASE_URL=http://naraonn:8080
NARAONN_SUBMIT_TIMEOUT_SECONDS=120
NARAONN_POLL_TIMEOUT_SECONDS=30
# O .ogg fica em `audio/leitura/_pendentes/` no S3 entre o "analisar" e o
# "confirmar". Configure uma lifecycle rule no bucket expirando esse prefixo
# em 1 dia para limpar áudios órfãos (análises abandonadas/canceladas).

# Configuração da recuperação de senha (Mailtrap)
# Aponta para a porta publicada do frontend no host (ver docker-compose.yml: "5174:5173")
FRONTEND_URL=http://localhost:5174
MAILTRAP_API_TOKEN=a340ec3c2ae0ab6f22f44f3df3435cce
EMAIL_BACKEND=anymail.backends.mailtrap.EmailBackend
DEFAULT_FROM_EMAIL=hello@demomailtrap.co
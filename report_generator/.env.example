# Copie para .env e ajuste conforme necessário.

# Porta HTTP do serviço
PORT=8000

# Tamanho máximo da fila de renderização. Requisições além do limite recebem 503.
MAX_QUEUE_SIZE=100

# Tempo máximo (s) que um job pode ficar aguardando + executando antes de retornar 504.
RENDER_TIMEOUT_SECONDS=60

# Segredo compartilhado com o backend Django. Se definido, o renderer exige o header
# X-Renderer-Secret em todas as requisições. Deixe vazio para desabilitar.
RENDERER_SHARED_SECRET=

# Verbosidade dos logs. DEBUG inclui: tempos por etapa, console.* da página, requests
# que falharam, erros de JS, payload size, etc. INFO é suficiente em produção.
LOG_LEVEL=DEBUG

# Sentry (opcional). Deixe SENTRY_DSN vazio para desabilitar.
# O HTML enviado ao /render pode conter nomes de crianças (PII), então
# send_default_pii fica desligado e o corpo da requisição é redigido antes de
# ser enviado ao Sentry.
SENTRY_DSN=https://f1cd45481fea6f40f446758638e766f0@o4511038973214720.ingest.us.sentry.io/4511038977343488
SENTRY_ENVIRONMENT=development
# Identificador do release (ex.: SHA do commit ou tag). Vazio = não envia release.
SENTRY_RELEASE=1.0
# Fração de transações amostradas para tracing (0.0 a 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Fração de profiles coletados (0.0 desabilita profiling).
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Exemplo de variáveis para o backend Django
# Duplicate this file to `.env` and adjust the values locally.

# ==== Django Configuration ====
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==== PostgreSQL Database (substitui SQLite) ====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nara_production
POSTGRES_USER=nara_user
POSTGRES_PASSWORD=secure_password

# ==== OpenAI API ====
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_TIMEOUT_SECONDS=45
IA_REQUEST_TIMEOUT_SECONDS=45
IA_AUDIO_TIMEOUT_SECONDS=45

# ==== AWS S3 Storage ====
AWS_ACCESS_KEY_ID=AKIAXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_S3_BUCKET_NAME=nara-production
AWS_REGION=us-east-1

# ==== Limites de upload (valores padrão recomendados) ====
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=50
UPLOAD_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# ==== EXPERIMENTAL: Reconhecimento de Fala Infantil ====
# Módulo experimental para análise de fala de crianças
# Cliente avisado: ainda não há IAs com precisão ideal para fala infantil
# Testar alternativas: ElevenLabs, Gemini, OpenAI Whisper

# ElevenLabs (opcional)
ELEVENLABS_API_KEY=

# Google Gemini (opcional)
GEMINI_API_KEY=

# Whisper (OpenAI) - já incluído no OPENAI_API_KEY

# Configuração da recuperação de senha (Mailtrap)
FRONTEND_URL=http://localhost:5173
MAILTRAP_API_TOKEN=a340ec3c2ae0ab6f22f44f3df3435cce
EMAIL_BACKEND=anymail.backends.mailtrap.EmailBackend
DEFAULT_FROM_EMAIL=hello@demomailtrap.co

# ==== Scheduler (worker externo que alimenta o cache da coordenação) ====
# Token compartilhado. O scheduler envia no header X-Internal-Token ao chamar
# POST /api/internal/cache/coordenacao/. Deixe vazio para desabilitar.
NARA_INTERNAL_TOKEN=

# UUID da instituição servida por este backend. Cada deploy é dedicado a
# uma escola, então o instituicao_id é configurado aqui — o backend não
# infere de Usuario.instituicao nem confia no body do scheduler.
NARA_INSTITUICAO_ID=

# ==== Report Generator (Playwright microservice) ====
# URL interna do serviço dentro da rede do docker-compose.
REPORT_GENERATOR_URL=http://report_generator:8000
# Deixe vazio para desabilitar. Se definido, precisa bater com RENDERER_SHARED_SECRET
# do serviço report_generator e é enviado no header X-Renderer-Secret.
REPORT_GENERATOR_SECRET=
# Limites opcionais, lidos pelo serviço via variáveis ambientes próprias.
REPORT_GENERATOR_MAX_QUEUE_SIZE=100
REPORT_GENERATOR_TIMEOUT=60

# ==== Transcrição de áudio ====
# Seleciona o backend usado por `transcrever_audio`:
#   openai               -> Whisper-1 via OpenAI API (padrão)
#   faster_whisper       -> microserviço local transcription_service (Whisper Large v3)
#   openai_with_fallback -> tenta OpenAI; em rate-limit/quota/auth/5xx/conexão
#                           cai automaticamente para o microserviço local
TRANSCRIPTION_PROVIDER=openai

# Usados quando TRANSCRIPTION_PROVIDER=faster_whisper ou openai_with_fallback
TRANSCRIPTION_SERVICE_URL=http://transcription:8000
TRANSCRIPTION_SERVICE_TOKEN=
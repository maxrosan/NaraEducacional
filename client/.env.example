# Exemplo de variáveis para o frontend Vite/React
# Em desenvolvimento local, deixe VITE_API_BASE_URL vazio para usar o proxy do Vite
# (evita problemas de SameSite com cookies de sessão)
VITE_API_BASE_URL=
# URL do backend Django usada pelo proxy do Vite (apenas dev local; em Docker usa 'http://backend:8001')
VITE_BACKEND_URL=http://127.0.0.1:8001
VITE_INACTIVITY_TIMEOUT_MS = 18000000 # 5 horas em ms
# Copie para .env e preencha com os valores reais do ambiente.
#
# Broker/result backend do Celery. Deixe o default se estiver usando o
# docker-compose incluído (o serviço `redis` do mesmo compose). Em Easypanel
# ou Kubernetes aponte para o Redis gerenciado do projeto.
#   - Dentro do compose bundle: redis://redis:6379/0
#   - Easypanel (Redis no mesmo projeto): redis://<nome-do-servico>:6379/0
#   - Redis externo com auth: redis://:<senha>@host:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Opcional: separar o result backend (default = mesmo valor do broker).
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# Fuso horário (crontab do beat).
CELERY_TIMEZONE=America/Sao_Paulo

# Horário do refresh diário (D-1).
CACHE_REFRESH_HOUR=2
CACHE_REFRESH_MINUTE=0

# Registry das escolas (recomendado em Easypanel/Kubernetes).
# Use UMA das formas abaixo (JSON tem prioridade sobre YAML).
#
# JSON em linha única:
# ESCOLAS_JSON=[{"id":"escola-abc","nome":"Escola ABC","backend_url":"https://abc.nara.example","instituicao_id":"00000000-0000-0000-0000-000000000000","internal_token":"env:NARA_TOKEN_ABC"}]
#
# Ou YAML multilinha (algumas UIs aceitam, inclusive Easypanel):
# ESCOLAS_YAML=|
#   - id: escola-abc
#     nome: Escola ABC
#     backend_url: https://abc.nara.example
#     instituicao_id: 00000000-0000-0000-0000-000000000000
#     internal_token: env:NARA_TOKEN_ABC
#
# Tokens internos por escola. Use `internal_token: env:<NOME_DA_VAR>` no
# registry e declare a variável aqui para evitar commitar o segredo.
# NARA_TOKEN_ABC=troque-me

# Sentry (opcional)
# SENTRY_DSN=
